# ──────────────────────────────────────────
# LOCAL DEVELOPMENT (Docker Compose)
# copy file นี้ → .env แล้วรัน docker compose up -d
# ──────────────────────────────────────────

# Database
DATABASE_URL=postgres://ota:ota_password@postgres:5432/otadb?sslmode=disable

# Redis (optional — ถ้าไม่ใส่ระบบจะ skip)
REDIS_URL=redis://redis:6379

# MinIO / Storage (local)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=firmware
MINIO_USE_SSL=false

# MQTT (local EMQX)
MQTT_BROKER=tcp://emqx:1883
MQTT_CLIENT_ID=ota-server
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# API
API_PORT=8000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=24

# ECDSA Keys
ECDSA_PRIVATE_KEY_PATH=./keys/private.pem
ECDSA_PUBLIC_KEY_PATH=./keys/public.pem

# Environment
ENV=development

# ──────────────────────────────────────────
# CLOUD PRODUCTION (ใส่ใน Render.com ENV)
# ──────────────────────────────────────────

# DATABASE_URL=postgresql://[user]:[password]@[host].supabase.co:5432/postgres?sslmode=require
# REDIS_URL=                                      ← ไม่ใส่ = skip Redis

# MINIO_ENDPOINT=[account-id].r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=[Cloudflare R2 Access Key ID]
# MINIO_SECRET_KEY=[Cloudflare R2 Secret Access Key]
# MINIO_BUCKET=firmware
# MINIO_USE_SSL=true

# MQTT_BROKER=ssl://[cluster-id].s1.eu.hivemq.cloud:8883
# MQTT_USE_TLS=true
# MQTT_USERNAME=[hivemq-username]
# MQTT_PASSWORD=[hivemq-password]

# JWT_SECRET=[random 64 chars — ใช้ Render auto-generate]
# ECDSA_PRIVATE_KEY_B64=[output ของ scripts/encode_key.ps1]
# ENV=production
