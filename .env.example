# Database
DATABASE_URL=postgres://ota:ota_password@postgres:5432/otadb?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# MinIO / Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=firmware
MINIO_USE_SSL=false

# MQTT
MQTT_BROKER=tcp://emqx:1883
MQTT_CLIENT_ID=ota-server
MQTT_USERNAME=
MQTT_PASSWORD=

# API
API_PORT=8000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=24

# ECDSA Keys (generate with scripts/gen_keys.sh)
ECDSA_PRIVATE_KEY_PATH=./keys/private.pem
ECDSA_PUBLIC_KEY_PATH=./keys/public.pem

# Environment
ENV=development
